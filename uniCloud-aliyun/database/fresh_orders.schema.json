{
  "bsonType": "object",
  "permission": { "read": false, "create": false, "update": false, "delete": false },
  "required": ["id", "ownerId", "status", "items", "address", "deliverySlot", "totalAmount", "paymentStatus", "createdAt"],
  "properties": {
    "id": { "bsonType": "string", "unique": true, "index": true },
    "ownerId": { "bsonType": "string", "index": true },
    "status": { "bsonType": "string", "enum": ["待付款", "待备货", "配送中", "已完成", "已取消", "退款申请中", "已退款", "退款驳回"] },
    "items": {
      "bsonType": "array",
      "minItems": 1,
      "items": {
        "bsonType": "object",
        "required": ["productId", "name", "price", "quantity"],
        "properties": {
          "productId": { "bsonType": "string" },
          "name": { "bsonType": "string" },
          "image": { "bsonType": "string" },
          "unit": { "bsonType": "string" },
          "price": { "bsonType": "number", "minimum": 0 },
          "quantity": { "bsonType": "int", "minimum": 1 }
        }
      }
    },
    "address": { "bsonType": "object" },
    "deliverySlot": { "bsonType": "string" },
    "productAmount": { "bsonType": "number", "minimum": 0 },
    "deliveryFee": { "bsonType": "number", "minimum": 0 },
    "coupon": { "bsonType": "number", "minimum": 0 },
    "totalAmount": { "bsonType": "number", "minimum": 0 },
    "remark": { "bsonType": "string" },
    "paymentStatus": { "bsonType": "string", "enum": ["未支付", "已支付"] },
    "createdAt": { "bsonType": "int" },
    "updatedAt": { "bsonType": "int" }
  }
}
